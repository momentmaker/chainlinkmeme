---
import Base from '../layouts/Base.astro';
import Gallery, { ThemeToggle, ProgressBar, HexScrollTop } from '../components/Gallery';
import { memeOfDay } from '../lib/meme-of-day';
import { fullUrl, memeUrl, permalinkUrl, thumbUrl } from '../lib/meme-url';
import { cardNumber, dayLabel } from '../lib/stage';
import { buildTagRail } from '../lib/tag-rail';
import path from 'node:path';
import '../styles/stage.css';
import type { Manifest } from '../lib/manifest';
import manifestJson from '../../public/manifest.json';

// Manifest is imported server-side *only* to pick the meme-of-the-day for the
// initial HTML. The Gallery component itself fetches /manifest.json at runtime
// so the full data doesn't get serialized into the hydration payload.
const manifest = manifestJson as Manifest;
const mod = memeOfDay(manifest.memes);
// Read from the built atlas on disk (public/atlas, produced before astro
// build); without it the rail still renders, just with plainer covers.
const tagRail = buildTagRail(manifest.memes, path.resolve('public/atlas'));
// "new" badges: anything added in the 45 days before this build. The legacy
// import all shares 2020-02-11, so it never qualifies.
const freshSince = new Date(Date.parse(manifest.generated_at ?? new Date().toISOString()) - 45 * 86400_000).toISOString().slice(0, 10);
const modIndex = mod ? manifest.memes.indexOf(mod) : -1;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const manifestHref = `${base}/manifest.json`;

// Same title-fallback the permalink + OG use: md5-looking legacy filenames
// get replaced with #firsttag so nobody sees a 32-hex string as UI copy.
const HASH_RE = /^[0-9a-f]{10,}$/i;
const heroTitle = mod
  ? (mod.title && !HASH_RE.test(mod.title) ? mod.title : (mod.tags[0] ? `#${mod.tags[0]}` : 'meme of the day'))
  : '';

// Stats strip — computed at build time, shown once in the footer.
// "last built" reflects the manifest generation time (≈ last deploy). Using
// date_added maxima is misleading here because every legacy meme shares the
// 2020-02-11 import placeholder.
const lastBuilt = manifest.generated_at ? manifest.generated_at.slice(0, 10) : '';
const stats = {
  memes: manifest.memes.length.toLocaleString(),
  tags: manifest.tags.length.toLocaleString(),
  lastBuilt,
};

// Home OG — cache-busted by the manifest timestamp so every deploy re-unfurls
// fresh in Discord/Twitter/Telegram. Same file path, new query, new hash.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://chainlinkme.me';
const homeOg = `${siteUrl}/og/_home.png?v=${encodeURIComponent(lastBuilt || 'initial')}`;
---
<Base
  title="⬡⏣⬢ chainlink meme ⬢⏣⬡"
  description="community-curated archive of chainlink memes — browse, search by tag, favorite, share"
  ogImage={homeOg}
>
  <Fragment slot="head-extra">
    <link rel="preload" href={manifestHref} as="fetch" crossorigin="anonymous" />
  </Fragment>

  <ProgressBar client:load slot="progress" />
  <ThemeToggle client:load slot="header-actions" />

  {mod && (
    <section
      class="stage"
      data-stage
      data-base={base}
      data-manifest={manifestHref}
      data-mod-slug={mod.slug}
      aria-label="Meme of the day"
    >
      <canvas class="stage-mosaic" data-stage-mosaic data-sheet={`${base}/atlas/hero.webp?v=${encodeURIComponent(lastBuilt || 'initial')}`} aria-hidden="true"></canvas>
      <div class="stage-shade" aria-hidden="true"></div>

      <div class="stage-grid">
        <div class="stage-copy">
          <p class="stage-eyebrow"><span class="stage-pulse" aria-hidden="true"></span>meme of the day · <time data-stage-date>{dayLabel(new Date())}</time></p>
          <h2 class="stage-title" data-stage-title>{heroTitle}</h2>
          <ul class="stage-tags" data-stage-tags>
            {mod.tags.slice(0, 6).map((t) => <li><a href={`${base}/?q=${encodeURIComponent(t)}`}>#{t}</a></li>)}
          </ul>
          <div class="stage-actions">
            <a class="stage-btn primary" data-stage-open href={permalinkUrl(mod.slug)}>open the meme <span aria-hidden="true">→</span></a>
            <a class="stage-btn" data-stage-find href={`${base}/verse/#m=${encodeURIComponent(mod.slug)}`}>find it in the memeverse</a>
          </div>
          <p class="stage-next">next meme of the day in <span data-stage-countdown>··:··:··</span></p>
        </div>

        <a class="holo" data-stage-card data-stage-open href={permalinkUrl(mod.slug)} aria-label={`Open the meme of the day: ${heroTitle}`}>
          <span class="holo-inner">
            <span class="holo-art">
              <img class="holo-bg" data-stage-bg src={thumbUrl(mod.filename, 240)} alt="" aria-hidden="true" loading="eager" decoding="async" />
              <img
                class="holo-img"
                data-stage-img
                src={fullUrl(mod.filename, { animated: mod.animated })}
                alt={heroTitle}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                onerror={`this.onerror=null;this.src='${memeUrl(mod.filename)}'`}
              />
            </span>
            <span class="holo-foil" aria-hidden="true"></span>
            <span class="holo-glare" aria-hidden="true"></span>
            <span class="holo-plate">
              <span class="holo-mark"><svg viewBox="0 0 64 64" aria-hidden="true"><polygon points="32,6 54.5,19 54.5,45 32,58 9.5,45 9.5,19"/></svg>meme of the day</span>
              <span class="holo-no"><span data-stage-no>{cardNumber(modIndex)}</span><span class="holo-of" data-stage-of> / {manifest.memes.length.toLocaleString('en-US')}</span></span>
            </span>
          </span>
        </a>
      </div>

      <div class="stage-verse">
        <span class="stage-verse-badge">new</span>
        <span class="stage-verse-copy"><strong>the memeverse</strong> — all {stats.memes} memes as one 3D galaxy you can fly through, or rebuild your face out of</span>
        <span class="stage-verse-ctas">
          <a class="stage-btn glow" href={`${base}/verse/`}>enter the memeverse <span aria-hidden="true">→</span></a>
          <a class="stage-btn" href={`${base}/verse/#assemble`}>assemble yourself</a>
        </span>
      </div>
    </section>
  )}

  <Gallery client:load manifestUrl={manifestHref} tagRail={tagRail} freshSince={freshSince} />

  <HexScrollTop client:load />

  <p class="stats-strip" slot="footer-stats">
    <span><strong>{stats.memes}</strong> memes</span>
    <span class="dot">⬡</span>
    <span><strong>{stats.tags}</strong> tags</span>
    <span class="dot">⬡</span>
    <span>last built <strong>{stats.lastBuilt}</strong></span>
  </p>
</Base>

<script>
  import { mountStage } from '../lib/stage';
  // Rebinds on every astro:page-load so client-side navigation back home
  // brings the stage back to life; mountStage ignores a stage it already runs.
  mountStage();
  document.addEventListener('astro:page-load', mountStage);
</script>
